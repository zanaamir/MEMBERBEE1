# PostgreSQL connection string
DATABASE_URL="postgresql://memberbee:memberbee@localhost:5432/memberbee?schema=public"

# Public base URL of the site (used for metadata, sitemap, and CSP upgrade-insecure-requests on https)
APP_URL="http://localhost:3000"

# debug | info | warn | error
LOG_LEVEL="info"

# Used only by `npm run db:seed` to create/update an admin account (min. 12 characters)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Seed fictional demo clubs when NODE_ENV=production (always seeded in development)
SEED_DEMO="false"

# docker-compose only
POSTGRES_PASSWORD="memberbee"
